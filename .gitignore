# Dependencies (recreated by `npm install`)
node_modules/

# Build output (recreated by `npm run build`)
dist/

# Generated by the content pipeline (from Milestone 3)
src/generated/

# TypeScript build caches
*.tsbuildinfo

# Logs
*.log
npm-debug.log*

# Local environment files (never commit secrets)
.env
.env.*

# Editor and OS files
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
