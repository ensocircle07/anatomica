{
  "name": "anatomica",
  "private": true,
  "version": "0.1.0",
  "description": "ANATOMICA — The Clinical Anatomy Atlas. Understand the structure. Understand the consequence.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -b",
    "check:boundaries": "node scripts/check-boundaries.ts",
    "test": "vitest run",
    "build": "vite build && node scripts/generate-route-shells.ts",
    "verify": "npm run typecheck && npm run check:boundaries && npm run test && npm run build",
    "preview": "vite preview"
  },
  "dependencies": {
    "lucide-react": "^1.70.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "tailwindcss": "^4.3.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
